{
  "$description": "Clearpath design tokens. Source of truth for styles.css (@theme) and for the Figma variable collection. Format follows the W3C Design Tokens draft ($value/$type).",
  "color": {
    "ink":        { "$value": "#1B2326", "$type": "color", "$description": "Primary text" },
    "ink-muted":  { "$value": "#55636A", "$type": "color", "$description": "Secondary text, 6.1:1 on white" },
    "line":       { "$value": "#CBD3D1", "$type": "color", "$description": "Borders and rules (non-text)" },
    "line-strong":{ "$value": "#8A9894", "$type": "color", "$description": "Input borders, 3:1 on white" },
    "canvas":     { "$value": "#EEF1F0", "$type": "color", "$description": "App background" },
    "surface":    { "$value": "#FFFFFF", "$type": "color", "$description": "Panels and tables" },
    "petrol":     { "$value": "#12424F", "$type": "color", "$description": "Primary action, focus ring, nav" },
    "petrol-hover": { "$value": "#0C2F39", "$type": "color" },
    "petrol-tint":  { "$value": "#E2ECEE", "$type": "color" },
    "risk-low":   { "$value": "#1E6B4F", "$type": "color", "$description": "Low risk / cleared / approved" },
    "risk-low-tint": { "$value": "#E3F1EA", "$type": "color" },
    "risk-medium":{ "$value": "#8A5300", "$type": "color", "$description": "Medium risk / pending / waiting" },
    "risk-medium-tint": { "$value": "#FBEFD9", "$type": "color" },
    "risk-high":  { "$value": "#A3202E", "$type": "color", "$description": "High risk / rejected / error" },
    "risk-high-tint": { "$value": "#F9E3E5", "$type": "color" }
  },
  "font": {
    "family": { "$value": "'Public Sans', system-ui, sans-serif", "$type": "fontFamily" },
    "size": {
      "xs":   { "$value": "0.8125rem", "$type": "dimension", "$description": "13px meta" },
      "sm":   { "$value": "0.875rem", "$type": "dimension", "$description": "14px tables, labels" },
      "base": { "$value": "1rem", "$type": "dimension", "$description": "16px body" },
      "lg":   { "$value": "1.25rem", "$type": "dimension", "$description": "20px section titles" },
      "xl":   { "$value": "1.75rem", "$type": "dimension", "$description": "28px page titles" },
      "amount": { "$value": "2.25rem", "$type": "dimension", "$description": "36px decision-rail amount" }
    }
  },
  "space": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" }
  },
  "radius": {
    "control": { "$value": "4px", "$type": "dimension", "$description": "Buttons, inputs" },
    "panel":   { "$value": "6px", "$type": "dimension", "$description": "Panels, dialogs" }
  }
}
